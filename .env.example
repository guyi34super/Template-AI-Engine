# ===== AI-RAG Engine — Environment Configuration =====
# Copy this file to .env and fill in your values.

# ===== Required: LLM Provider =====
HUGGINGFACE_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxx
HF_CHAT_MODEL=mistralai/Mistral-7B-Instruct-v0.2
HF_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
HF_EMBED_MODEL_FAST=sentence-transformers/all-MiniLM-L6-v2
HF_EMBED_MODEL_QUALITY=sentence-transformers/all-mpnet-base-v2
EMBED_BATCH_SIZE=32
EMBED_CACHE_TTL_SEC=86400
HF_EXTRACTION_MODEL=mistralai/Mistral-7B-Instruct-v0.3
LLM_TIMEOUT_SEC=120
LLM_MAX_RETRIES=3

# ===== Required: Memory Provider =====
SUPERMEMORY_URL=http://localhost:3100
SUPERMEMORY_API_KEY=sm_xxxxxxxxxxxxxxxxxxxx
SUPERMEMORY_TIMEOUT=10
SUPERMEMORY_CB_THRESHOLD=5
SUPERMEMORY_CB_COOLDOWN=60

# ===== Required: Database =====
POSTGRES_USER=airag
POSTGRES_PASSWORD=airag_secret
POSTGRES_DB=airag
DATABASE_URL=postgresql+asyncpg://airag:airag_secret@db:5432/airag

# ===== Required: Cache =====
REDIS_URL=redis://redis:6379/0

# ===== Required: Auth (JWT) =====
JWT_SECRET=change-me-to-a-secure-random-string
JWT_ACCESS_EXPIRY_MIN=15
JWT_REFRESH_EXPIRY_MIN=10080
# For RS256 in production, set PEM strings:
# JWT_PRIVATE_KEY=-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----
# JWT_PUBLIC_KEY=-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----

# ===== Optional: Rust Data-Tier Service =====
RUST_SERVICE_URL=http://rust-service:8001
RUST_HOST=0.0.0.0
RUST_PORT=8001
RUST_LOG=info
RUST_HMAC_SECRET=change-me-to-a-secure-random-string

# ===== Optional: ChromaDB =====
CHROMA_REMOTE=false
CHROMA_HOST=chromadb
CHROMA_PORT=8100
CHROMA_PERSIST_DIR=data/chroma

# ===== Optional: Databricks (legacy) =====
# DATABRICKS_TOKEN=dapi_xxxxxxxxxxxxxxxxxxxx
# DATABRICKS_LLM_ENDPOINT=https://your-workspace.databricks.com/serving-endpoints/databricks-meta-llama-3-3-70b-instruct/invocations
# DATABRICKS_SMALL_LLM_ENDPOINT=databricks-meta-llama-3-1-8b-instruct
# DATABRICKS_EMBEDDING_ENDPOINT=databricks-gte-large-en

# ===== Server =====
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development
RELOAD=false
LOG_LEVEL=INFO

# ===== Limits =====
MAX_FILE_SIZE_MB=50
MAX_TOKENS=8000
TEMPERATURE=0.1
TOP_P=0.9
